
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8"
    <meta name="keywords" content="Shop quần áo" />
    <meta name="description" content="Chuyên bán quàn áo cao cấp" />
    <title>Home</title>



    <link href="~/Content/style.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Geomini:wght@200..800&display=swap" rel="stylesheet">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=phone_enabled" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Geomini:wght@200..800&display=swap" rel="stylesheet">
    <style>

        .geomini-intro {
            font-family: "Geomini", sans-serif;
            font-optical-sizing: auto;
            font-weight: 300;
            font-style: normal;
        }

        .geomini-brand {
            font-family: "Geomini", sans-serif;
            font-optical-sizing: auto;
            font-weight: 400;
            font-style: normal;
        }

        .fm-menu {
            padding: 10px;
            background-color: blue;
            border-radius: 10px;
            text-align: center;
            width: 150px;
        }

        nav a {
            text-decoration: none;
            color: antiquewhite;
        }

            nav a:hover {
                background-color: blueviolet;
                color: black;
            }

        .fm-img-content {
            width: 250px;
            height: 200px;
            border-radius: 10px;
        }

        .fm-content-item {
            text-align: center;
        }
    </style>
</head>
<body>
    <div>
        <header class="header-bar">
            <a href="#" class="logo-box">
                <img src="~/Image/3changlinhngulam.jpg" class="logo" alt="Logo" style="height: 50px; width: auto; object-fit: contain;" />
                <h1 class="cormorant-infant-brand">Shop quần áo</h1>
            </a>
            <div class="hotline-box">
                <p>Hotline: <i class="fa-solid fa-phone"></i> 1234567890</p>
            </div>

            <div style="display: flex; align-items: center; gap: 20px; font-size: 16px;">
                <!-- Kiểm tra trạng thái đăng nhập -->
                @if (Session["Username"] != null)
                {
                    <span style="font-weight: bold; color: #001133;">
                        <i class="fa-regular fa-user"></i> Xin chào, @Session["Username"]!
                    </span>
                    <a href="@Url.Action("Logout", "Login")" style="color: #d9534f; text-decoration: none; font-weight: bold; padding: 5px 10px; border: 1px solid #d9534f; border-radius: 4px;">
                        Đăng xuất
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Index", "Login")" title="Đăng nhập" style="color: #333; text-decoration: none; padding: 5px; font-weight: bold;">
                        <i class="fa-regular fa-user"></i> Đăng nhập
                    </a>
                    <a href="@Url.Action("Register", "Login")" title="Đăng ký" style="background: #001133; color: white; text-decoration: none; padding: 6px 12px; border-radius: 4px; font-weight: bold;">
                        Đăng ký
                    </a>
                }

                <!-- Icon Giỏ hàng -->
                <a href="@Url.Action("Index", "Cart")" title="Giỏ hàng" style="color: #333; text-decoration: none; padding: 5px; font-size: 20px;">
                    <i class="fa-solid fa-cart-shopping"></i>
                </a>
            </div>

        </header>
        <img src="~/Image/welcome.jpg" style="height:400px;width:100%" />
        <p class="geomini-intro">
            Chào mừng đến với shop quần áo của ba chàng lính ngự lâm
        </p>
    </div>
    <div class="icon-show" onclick="togleMenu()">
        <i class="fa-solid fa-bars"></i>
    </div>
    <nav>
        <ol class="fm-menu" id="fm-menu" style="list-style:none; ">
            <li class="item-menu">
                <a href="@Url.Action("Ao", "Home")">Áo</a>
            </li>
            <li class="item-menu">
                <a href="@Url.Action("Quan", "Home")">Quần</a>
            </li>
            <li class="item-menu">
                <a href="@Url.Action("Non", "Home")">Nón</a>
            </li>
            <li class="item-menu">
                <a href="@Url.Action("Giay", "Home")">Giày</a>
            </li>
            <li class="item-menu">
                <a href="@Url.Action("Kinh", "Home")">Kính</a>
            </li>
            <li class="item-menu">
                <a href="@Url.Action("Phukien", "Home")">Phụ kiện</a>
            </li>
        </ol>
    </nav>

    <main class="fm-main">
        <section class="fm-products">
            <article class="fm-content-item">
                <h2>Áo </h2>
                <img src="~/Image/ao.jpg" class="fm-img-content" />
                <p>Áo đẹp</p>
            </article>
            <article class="fm-content-item">
                <h2>Quần </h2>
                <img src="~/Image/quan.jpg" class="fm-img-content" />
                <p>Quần đẹp</p>
            </article>
            <article class="fm-content-item">
                <h2>Nón </h2>
                <img src="~/Image/nón.jpg" class="fm-img-content" />
                <p>Nón đẹp</p>
            </article>
            <article class="fm-content-item">
                <h2>Giày </h2>
                <img src="~/Image/giày.jpg" class="fm-img-content" />
                <p>Giày đẹp</p>
            </article>
            <article class="fm-content-item">
                <h2>Phụ kiện</h2>
                <img src="~/Image/phukien.jpg" class="fm-img-content" />
                <p>Phụ kiện đẹp</p>
            </article>
            <article class="fm-content-item">
                <h2>Kính</h2>
                <img src="~/Image/kinh.jpg" class="fm-img-content" />
                <p>Kính đẹp</p>
            </article>
        </section>

        <aside class="fm-sidebar">
            <h3>Opening Hours:</h3>
            <p>06:45 AM - 22:00 PM</p>
            <img src="~/Image/sale1.jpg" class="fm_poster" />
            <br />
            <img src="~/Image/sale2.jpg" class="fm_poster" />
        </aside>
    </main>
    <footer style="background-color: #001133; color: white; padding: 40px 20px; font-family: sans-serif; margin-top: 40px;">
        <div style="display: flex; justify-content: space-between; max-width: 1200px; margin: 0 auto; flex-wrap: wrap; gap: 20px;">

            <!-- Cột 1 -->
            <div style="flex: 1; min-width: 250px;">
                <h3 style="color: #fff; margin-bottom: 10px;">BA CHÀNG LÍNH NGỰ LÂM</h3>
                <p><i class="fa-solid fa-phone"></i> Tổng đài CSKH: 1234567890</p>
                <p><i class="fa-solid fa-envelope"></i> Email: support@bachanglinhngulam.com</p>
                <h4 style="margin-top: 15px; margin-bottom: 5px; font-size: 14px;">Thông tin chủ sở hữu</h4>
                <p style="font-size: 12px; line-height: 1.5; color: #ccc;">
                    Shop quần áo Ba Chàng Lính Ngự Lâm<br>
                    Trụ sở chính: TP. Hồ Chí Minh
                </p>
            </div>

            <!-- Cột 2 -->
            <div style="flex: 1; min-width: 200px;">
                <h4 style="margin-bottom: 15px; font-size: 14px;">HỖ TRỢ KHÁCH HÀNG</h4>
                <ul style="list-style: none; padding: 0; line-height: 2; font-size: 13px; color: #ccc;">
                    <li><a href="#" style="color: #ccc; text-decoration: none;">Chính sách đổi hàng và bảo hành</a></li>
                    <li><a href="#" style="color: #ccc; text-decoration: none;">Chính sách Membership</a></li>
                    <li><a href="#" style="color: #ccc; text-decoration: none;">Chính sách ưu đãi sinh nhật</a></li>
                    <li><a href="#" style="color: #ccc; text-decoration: none;">Chính sách bảo mật</a></li>
                    <li><a href="#" style="color: #ccc; text-decoration: none;">Chính sách giao hàng</a></li>
                </ul>
            </div>

            <!-- Cột 3 -->
            <div style="flex: 1; min-width: 220px;">
                <h4 style="margin-bottom: 15px; font-size: 14px;">HỆ THỐNG CỬA HÀNG</h4>
                <p style="font-size: 12px; line-height: 1.5; color: #ccc;">
                    <strong>📍 HỒ CHÍ MINH</strong><br>
                    Sư Vạn Hạnh, TP. Hồ Chí Minh
                </p>
                <p style="font-size: 12px; line-height: 1.5; color: #ccc;">
                    <strong>📍HỒ CHÍ MINH</strong><br>
                    Quận 8,TP. Hồ Chí Minh
                </p>
            </div>

            <!-- Cột 4 -->
            <div style="flex: 1; min-width: 150px;">
                <h4 style="margin-bottom: 15px; font-size: 14px;">PHƯƠNG THỨC THANH TOÁN</h4>
                <div style="background: #222; display: inline-block; padding: 5px 10px; font-weight: bold; border-radius: 4px; margin-bottom: 10px; font-size: 12px;">COD</div>
                <div>
                    <div style="border: 1px solid #00bfff; color: #00bfff; padding: 5px 8px; display: inline-block; font-size: 11px; font-weight: bold;">VCB</div>
                    <div style="border: 1px solid #00bfff; color: #00bfff; padding: 5px 8px; display: inline-block; font-size: 11px; font-weight: bold;">Momo</div>
                </div>
            </div>

        </div>

        <!-- Dòng bản quyền -->
        <div style="text-align: center; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 30px; padding-top: 15px; font-size: 12px; color: #aaa;">
            © Bản quyền thuộc về <strong>Ba Chàng Lính Ngự Lâm</strong>
        </div>
    </footer>
    <div>
        <script>
            function togleMenu() {
                var menu = document.getElementById("fm-menu");
                if (menu.style.display === "block") {
                    menu.style.display = "none";
                } else {
                    menu.style.display = "block";
                }
            }
        </script>
    </div>
</body>
</html>
